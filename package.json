{
  "name": "fridgechef",
  "version": "1.0.0",
  "main": "index.ts",
  "onnxruntimeExtensionsEnabled": "false",
  "expo": {
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    }
  },
  "dependencies": {
    "@noble/hashes": "^1.8.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.18.14",
    "@react-navigation/native": "^7.3.3",
    "@react-navigation/native-stack": "^7.17.5",
    "expo": "^57.0.17",
    "expo-asset": "~57.0.16",
    "expo-dev-client": "~57.0.18",
    "expo-file-system": "~57.0.6",
    "expo-image-picker": "~57.0.15",
    "expo-linear-gradient": "~57.0.1",
    "expo-screen-capture": "~57.0.2",
    "expo-secure-store": "~57.0.3",
    "expo-sqlite": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "lucide-react-native": "^1.28.0",
    "onnxruntime-react-native": "^1.24.3",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "~19.2.2",
    "@types/react-test-renderer": "^19.1.0",
    "react-test-renderer": "^19.2.3",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "powershell -ExecutionPolicy Bypass -File scripts/android-device-dev.ps1",
    "android:dev-build": "powershell -ExecutionPolicy Bypass -File scripts/android-device-dev.ps1",
    "android:device": "powershell -ExecutionPolicy Bypass -File scripts/android-device-dev.ps1",
    "start:dev-client": "expo start --dev-client",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test",
    "test:types": "tsc --noEmit -p tsconfig.test.json",
    "preprocess:rag": "node scripts/preprocess-recipes-rag.cjs",
    "postinstall": "node scripts/patch-react-native-gradle-plugin.cjs && node scripts/patch-onnxruntime-react-native.cjs"
  },
  "private": true
